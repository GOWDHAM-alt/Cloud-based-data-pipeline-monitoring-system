# Base URL of the backend API (Owner A's service). Point at the mock
# server (tools/mock_server.py) while developing, then at the real API.
MONITOR_API_URL=http://localhost:8001

# Shared key sent in the X-API-Key header. Fake value here — real key
# lives in .env (git-ignored) or the cloud secret store.
MONITOR_API_KEY=changeme

# true/false — turns all reporting off. Used for the overhead comparison
# in Phase 6. When false, MonitorReporter and the metrics agent are no-ops.
MONITORING_ENABLED=true

# How often the metrics agent samples CPU/memory, in seconds.
METRICS_INTERVAL_SECONDS=10

# Which data source the pipeline reads from: csv | json | api
PIPELINE_DATA_SOURCE=csv
PIPELINE_SOURCE_PATH=data/sample_sales.csv

# Host label the metrics agent reports as.
METRICS_HOST_NAME=worker-1
